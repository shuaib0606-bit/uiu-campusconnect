APP_NAME="UIU CampusConnect"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Asia/Dhaka"
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# MySQL is the supported database for this app.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uiu_campusconnect
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Database cache/queue by default — swap to redis in production for best performance.
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@uiu.ac.bd"
MAIL_FROM_NAME="${APP_NAME}"

# Name of the cookie used to persist the visitor's light/dark preference.
THEME_COOKIE_NAME=cc_theme

VITE_APP_NAME="${APP_NAME}"
